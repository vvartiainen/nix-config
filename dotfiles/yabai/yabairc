#!/usr/bin/env sh

yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

yabai -m config external_bar all:49:0 \
  mouse_follows_focus off \
  focus_follows_mouse off \
  window_zoom_persist off \
  window_placement second_child \
  window_shadow float \
  window_opacity on \
  window_opacity_duration 0.15 \
  active_window_opacity 1.0 \
  normal_window_opacity 0.85 \
  window_animation_duration 0.0 \
  insert_feedback_color 0xff9dd274 \
  split_ratio 0.50 \
  auto_balance off \
  mouse_modifier fn \
  mouse_action1 move \
  mouse_action2 resize \
  mouse_drop_action swap \
  top_padding 10 \
  bottom_padding 10 \
  left_padding 10 \
  right_padding 10 \
  window_gap 8

# Label existing Spaces; only move them when the target display is connected.
setup_space() {
  space=$(yabai -m query --spaces --space "$1" 2>/dev/null) || return 0
  yabai -m space "$1" --label "$2"
  if yabai -m query --displays --display "$3" >/dev/null 2>&1 &&
    [ "$(printf '%s' "$space" | jq -r '.display')" != "$3" ]; then
    yabai -m space "$1" --display "$3"
  fi
}

setup_space 1 Start 1
setup_space 2 Browser 2
setup_space 3 Code 2
setup_space 4 Notes 2
setup_space 5 Misc 2

# Skip app assignments when their destination Space does not exist.
assign_app() {
  yabai -m query --spaces --space "$2" >/dev/null 2>&1 || return 0
  yabai -m rule --add app="$1" space="$2"
}

# Start
assign_app "Slack" "Start"
assign_app "Safari" "Start"

# Browser, disabled to allow little arc on same space
# yabai -m rule --add app="Arc" space="Browser"

# Programming
# assign_app "kitty" "Code"

# Notes
assign_app "Notion" "Notes"
assign_app "Obsidian" "Notes"
assign_app "Calendar" "Notes"
assign_app "Linear" "Notes"
assign_app "Notes" "Notes"

# Misc
assign_app "Spotify" "Misc"
assign_app "Discord" "Misc"
assign_app "Whatsapp" "Misc"

yabai -m rule --add app="^(Calculator|Software Update|Dictionary|System Preferences|System Settings|Photo Booth|Archive Utility|App Store|Steam|Activity Monitor)$" manage=off
yabai -m rule --add label="Finder" app="^Finder$" title="(Co(py|nnect)|Move|Info|Pref)" manage=off
yabai -m rule --add label="Safari" app="^Safari$" title="^(General|(Tab|Password|Website|Extension)s|AutoFill|Se(arch|curity)|Privacy|Advance)$" manage=off
yabai -m rule --add label="About This Mac" app="System Information" title="About This Mac" manage=off

# Catch 1Password's specific extension helpers and system level unlock overlays
# # 1. Force the system ControlCenter biometric prompt completely out of the window tree
yabai -m rule --add app="^ControlCenter$" manage=off sub-layer=above

# 2. Add an explicit regex rule to target ALL variations of 1Password's sub-windows
# Keep these windows unmanaged and fully opaque.
yabai -m rule --add app="^1Password.*$" manage=off sub-layer=above opacity=1.0

# 3. Handle the browser extensions specifically (e.g. if using Arc or Safari)
yabai -m rule --add app="^1Password Extension$" manage=off sub-layer=above opacity=1.0

# yabai -m signal --add event=window_destroyed action="yabai -m query --windows --window &> /dev/null || yabai -m window --focus recent || yabai -m window --focus first"
# yabai -m signal --add event=application_terminated action="yabai -m query --windows --window &> /dev/null || yabai -m window --focus recent || yabai -m window --focus first"

yabai -m config layout stack

yabai -m rule --apply
