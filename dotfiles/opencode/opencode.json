{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/gpt-5.4",
  "permission": {
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "grep *": "allow",
      "npm run test *": "allow",
      "npm run build *": "allow",
      "npm run format *": "allow",
      "npm test *": "allow",
      "npx vitest *": "allow",
      "npx tsc *": "allow",
      "npx eslint *": "allow",
      "terraform fmt *": "allow",
      "terraform validate *": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  }
}
