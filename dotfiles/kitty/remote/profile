# Login profile for bash on kitten ssh hosts, see ssh.conf.
# kitty's bash integration sources this in place of /etc/profile.
[ -r /etc/profile ] && . /etc/profile

# Deferred to the first prompt so these win over aliases from the remote ~/.bashrc.
_kssh_rc() {
    [ -n "${_kssh_rc_done-}" ] && return
    _kssh_rc_done=1

    if command ls --hyperlink=auto -d / >/dev/null 2>&1; then
        alias ls='ls --color=auto --hyperlink=auto'
    fi
    alias la='ls -la'
    alias rg='rg --hyperlink-format=kitty'
    alias kt='kitten transfer'
}
PROMPT_COMMAND="_kssh_rc${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
