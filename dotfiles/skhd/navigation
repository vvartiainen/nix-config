# Arrow navigation in Slack menus, search and the message editor.
ctrl - n [
  "Slack" | down
  * ~
]

ctrl - p [
  "Slack" | up
  * ~
]

# One key enters the focused app's navigation mode.
# Loaded last so every mode it targets is already declared.
default, winmode, resize < $mode - space [
  "kitty" : /bin/bash "$HOME/.config/skhd/kitty.sh" enter
  "kitty-quick-access" : /bin/bash "$HOME/.config/skhd/kitty.sh" enter
  "zen" ; zen_mode
  "Rex Beta" ; rex_mode
  "Rex" ; rex_mode
  * ~
]

herdr_mode, kitty_mode, zen_mode, rex_mode < $mode - space ; default
