# H/L follows horizontal workspaces; J/K follows vertical tabs.
:: zen_mode @ : /bin/bash "$HOME/.config/skhd/mode-indicator.sh" zen

# Finnish ´ key (ANSI Equal position), without Shift; keep native Cmd+S too.
zen_mode < cmd - 0x18 [
  "zen" | cmd - s
  * ~
]

zen_mode < h | ctrl + shift - h
zen_mode < l | ctrl + shift - l
zen_mode < j | ctrl - tab
zen_mode < k | ctrl + shift - tab

# Leave capture before opening anything that accepts typed text.
zen_mode < n ; default : skhd --key "cmd - t"
zen_mode < o ; default : skhd --key "cmd - l"
zen_mode < f ; default : skhd --key "cmd - f"
zen_mode < cmd - t ; default : skhd --key "cmd - t"
zen_mode < cmd - l ; default : skhd --key "cmd - l"
zen_mode < cmd - k ; default : skhd --key "cmd - k"
zen_mode < cmd - f ; default : skhd --key "cmd - f"

zen_mode < escape ; default
zen_mode < return ; default
zen_mode < $mode - w ; winmode
zen_mode < $mode - r ; resize
