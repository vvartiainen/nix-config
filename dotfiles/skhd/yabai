$window - r : launchctl kickstart -k gui/"$(id -u)"/org.nixos.yabai

$focus  - return : yabai -m window --toggle zoom-fullscreen

$window - b : yabai -m space --layout bsp
$window - s : yabai -m space --layout stack

$window - f : yabai -m query --windows --space | jq '.[].id' | xargs -I{} yabai -m window {} --toggle zoom-fullscreen

# Space movement
ctrl - 1 : yabai -m space --focus 1
ctrl - 2 : yabai -m space --focus 2
ctrl - 3 : yabai -m space --focus 3
ctrl - 4 : yabai -m space --focus 4
ctrl - 5 : yabai -m space --focus 5
ctrl - 6 : yabai -m space --focus 6
ctrl - 7 : yabai -m space --focus 7
ctrl - 8 : yabai -m space --focus 8
ctrl - 9 : yabai -m space --focus 9

ctrl - left : yabai -m space --focus prev
ctrl - right : yabai -m space --focus next

$window - up : yabai -m space --move next
$window - down : yabai -m space --move prev

$window - n : yabai -m space --create
$window - d : yabai -m space --destroy

$window - left : $HOME/.config/yabai/movewindow.sh prev
$window - right : $HOME/.config/yabai/movewindow.sh next
$window - 1 : $HOME/.config/yabai/movewindow.sh 1
$window - 2 : $HOME/.config/yabai/movewindow.sh 2
$window - 3 : $HOME/.config/yabai/movewindow.sh 3
$window - 4 : $HOME/.config/yabai/movewindow.sh 4
$window - 5 : $HOME/.config/yabai/movewindow.sh 5
$window - 6 : $HOME/.config/yabai/movewindow.sh 6

# Swap windows
$window - h : yabai -m window --swap west
$window - j : yabai -m window --swap south
$window - k : yabai -m window --swap north
$window - l : yabai -m window --swap east

# Focus
$focus - h : yabai -m window --focus west
$focus - j : yabai -m window --focus south
$focus - k : yabai -m window --focus north
$focus - l : yabai -m window --focus east

# Rotate and focus windows on screen
# cmd - tab : yabai -m window --focus next || yabai -m window --focus first

# Stack layout support
cmd - tab : yabai -m window --focus stack.next || yabai -m window --focus stack.prev || yabai -m window --focus next || yabai -m window --focus first
$focus - p : yabai -m window --focus stack.prev || yabai -m window --focus stack.last || yabai -m window --focus prev || yabai -m window --focus last
$focus - n : yabai -m window --focus stack.next || yabai -m window --focus stack.first || yabai -m window --focus next || yabai -m window --focus first

$focus - down : yabai -m space --rotate 90

# Resize
cmd + lalt - h : yabai -m window --resize right:-100:0 || yabai -m window --resize left:-100:0
cmd + lalt - j : yabai -m window --resize bottom:0:100 || yabai -m window --resize top:0:100
cmd + lalt - k : yabai -m window --resize bottom:0:-100 || yabai -m window --resize top:0:-100
cmd + lalt - l : yabai -m window --resize right:100:0 || yabai -m window --resize left:100:0

# Hydra-style window arrangement; mode commands update the bar on entry.
:: default : /bin/bash "$HOME/.config/skhd/mode-indicator.sh" default
:: winmode @ : /bin/bash "$HOME/.config/skhd/mode-indicator.sh" window
:: resize @ : /bin/bash "$HOME/.config/skhd/mode-indicator.sh" resize

$focus - w ; winmode
$focus - r ; resize
$mode - w ; winmode
$mode - r ; resize

winmode < h : yabai -m window --focus west
winmode < j : yabai -m window --focus south
winmode < k : yabai -m window --focus north
winmode < l : yabai -m window --focus east

winmode < shift - h : yabai -m window --warp west
winmode < shift - j : yabai -m window --warp south
winmode < shift - k : yabai -m window --warp north
winmode < shift - l : yabai -m window --warp east

winmode < cmd - h : yabai -m window --resize right:-100:0 || yabai -m window --resize left:-100:0
winmode < cmd - j : yabai -m window --resize bottom:0:100 || yabai -m window --resize top:0:100
winmode < cmd - k : yabai -m window --resize bottom:0:-100 || yabai -m window --resize top:0:-100
winmode < cmd - l : yabai -m window --resize right:100:0 || yabai -m window --resize left:100:0

winmode < cmd + shift - h : yabai -m window --resize right:-25:0 || yabai -m window --resize left:-25:0
winmode < cmd + shift - j : yabai -m window --resize bottom:0:25 || yabai -m window --resize top:0:25
winmode < cmd + shift - k : yabai -m window --resize bottom:0:-25 || yabai -m window --resize top:0:-25
winmode < cmd + shift - l : yabai -m window --resize right:25:0 || yabai -m window --resize left:25:0

winmode < b : yabai -m space --balance
winmode < shift - b : yabai -m space --layout bsp
winmode < s : yabai -m space --layout stack
winmode < f : yabai -m window --toggle zoom-fullscreen

winmode < 1 : "$HOME/.config/yabai/movewindow.sh" 1
winmode < 2 : "$HOME/.config/yabai/movewindow.sh" 2
winmode < 3 : "$HOME/.config/yabai/movewindow.sh" 3
winmode < 4 : "$HOME/.config/yabai/movewindow.sh" 4
winmode < 5 : "$HOME/.config/yabai/movewindow.sh" 5
winmode < 6 : "$HOME/.config/yabai/movewindow.sh" 6

winmode < r ; resize
winmode < $mode - r ; resize
resize < $mode - r ; default
resize < w ; winmode

resize < h : yabai -m window --resize right:-100:0 || yabai -m window --resize left:-100:0
resize < j : yabai -m window --resize bottom:0:100 || yabai -m window --resize top:0:100
resize < k : yabai -m window --resize bottom:0:-100 || yabai -m window --resize top:0:-100
resize < l : yabai -m window --resize right:100:0 || yabai -m window --resize left:100:0

winmode, resize < escape ; default
winmode, resize < return ; default
winmode, resize < $focus - w ; default
winmode, resize < $mode - w ; default
