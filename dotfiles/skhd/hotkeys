ctrl + shift - space : kitten quick-access-terminal

# Finnish ´ key (ANSI Equal position): sidebar/tab bar, retaining Cmd+S.
cmd - 0x18 [
  "zen" | cmd - s
  "kitty" | cmd - s
  * ~
]

# Open or focus apps by bundle ID; leave Ctrl+Cmd+F for fullscreen.
$app - z : /usr/bin/open -b app.zen-browser.zen
$app - k : /usr/bin/open -b net.kovidgoyal.kitty
$app - c : /usr/bin/open -b com.apple.iCal
$app - o : /usr/bin/open -b md.obsidian
$app - m : /usr/bin/open -b com.apple.mail
$app - e : /usr/bin/open -b com.apple.finder

# Toggle a persistent quota dashboard, independent of the quick-access shell.
ctrl + cmd + shift - u : /bin/sh "$HOME/.config/kitty/metrics.sh"

# Use the same microphone toggle and volume restoration as the menu bar.
ctrl + cmd + shift - m : sketchybar --trigger mic_toggle

# Next/previous tabs in Zen and conversations in Slack.
ctrl + shift - j [
  "zen" | ctrl - tab
  "Slack" | alt - down
]
ctrl + shift - k [
  "zen" | ctrl + shift - tab
  "Slack" | alt - up
]

# Right Option+1–9 jumps to a Kitty or Rex tab; Left Option keeps layout
# characters, which Kitty mappings cannot tell apart. This takes Herdr's direct
# Alt+1–9 in Kitty; Herdr mode still jumps to agents.
