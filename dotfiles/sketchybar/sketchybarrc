#!/bin/bash

source "$CONFIG_DIR/colors.sh"

export PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

bar=(
  height=39
  color="$BASE"
  shadow=on
  position=top
  sticky=on
  padding_right=10
  padding_left=10
  corner_radius=9
  y_offset=10
  margin=10
  blur_radius=20
  notch_width=200
)

sketchybar --bar "${bar[@]}"

sketchybar --default icon.font="SF Pro:Semibold:15.0" \
  icon.color="$ICON_COLOR" \
  label.font="SF Pro:Semibold:15.0" \
  label.color="$TEXT" \
  background.corner_radius=5 \
  background.height=24 \
  padding_left=5 \
  padding_right=5 \
  label.padding_left=4 \
  label.padding_right=4 \
  icon.padding_left=4 \
  icon.padding_right=4

# -- Left Side Items --
source "$ITEM_DIR"/spaces.sh
source "$ITEM_DIR"/front_app.sh

# -- Right Side Items, added right to left --
# Item padding is inside a bracket's background, so pills need a spacer item
# between them.
pill_gap() {
  sketchybar --add item "$1" right \
    --set "$1" width=8 padding_left=0 padding_right=0 \
    icon.drawing=off label.drawing=off background.drawing=off
}

source "$ITEM_DIR"/calendar.sh
pill_gap gap.calendar
source "$ITEM_DIR"/yabai_layout.sh
source "$ITEM_DIR"/mic.sh
source "$ITEM_DIR"/wifi.sh
source "$ITEM_DIR"/vpn.sh
pill_gap gap.status
source "$ITEM_DIR"/volume.sh
source "$ITEM_DIR"/battery.sh
source "$ITEM_DIR"/ram.sh
source "$ITEM_DIR"/cpu.sh

# -- Shared backgrounds, after their members exist --
source "$ITEM_DIR"/brackets.sh

sketchybar --update
