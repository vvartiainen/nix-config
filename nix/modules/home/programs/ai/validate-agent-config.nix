{ lib, pkgs, ... }:
let
  validator =
    pkgs.writers.writePython3Bin "validate-agent-config"
      {
        libraries = [ (import ../../agent-config-validation.nix { inherit pkgs; }) ];
      }
      ''
        from agent_config_validation import main

        main()
      '';
in
{
  home = {
    packages = [ validator ];

    # Check files generated by Home Manager during the build. Mutable files
    # are absent here; their Nix settings are checked by merge-config.nix.
    extraBuilderCommands = ''
      ${lib.getExe validator} --home "$out/home-files" --config-home "$out/home-files/.config"
    '';

    activation.agentConfigValidation =
      lib.hm.dag.entryAfter
        [
          "agentToolsCleanup"
          "claudeCodeConfig"
          "claudeDesktopConfig"
          "codexMutableConfig"
          "cursorCliConfig"
          "githubCopilotCliSettings"
          "opencodeConfig"
        ]
        ''
          run ${lib.getExe validator}
        '';
  };
}
